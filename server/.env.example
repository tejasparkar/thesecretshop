PORT=5000
# Leave MONGO_URI empty to use an in-memory MongoDB (auto-seeded, data resets on restart).
# Atlas example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/thesecretshop
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@thesecretshop.com
ADMIN_PASSWORD=admin123
